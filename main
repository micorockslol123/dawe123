
if shared.GrabModule then
	shared.GrabModule = nil;
end;
shared.GrabModule = {};

local Players = game:GetService("Players");
local ReplicatedStorage = game:GetService("ReplicatedStorage");
local TweenService = game:GetService("TweenService");
local StarterGui = game:GetService("StarterGui");
local UserInputService = game:GetService("UserInputService");

local _LocalPlayer = Players.LocalPlayer;

local GyroLookAt = nil;
local SelectedAttachment = nil;

local _BodyGyro, _BodyPosition;
local MainAttachment;

function shared.GrabModule:RefreshAnimations()
	_LocalPlayer.Character.Animate.Disabled = true;
	for _, v in next, _LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks() do
		v:Stop();
	end;
	_LocalPlayer.Character.Animate.Disabled = false;
end;

function shared.GrabModule:Refresh()
	if _BodyGyro then
		_BodyGyro:Destroy();
	end;
	if _BodyPosition then
		_BodyPosition:Destroy();
	end;
	if SelectedAttachment then
		if SelectedAttachment.Parent == "AttachmentCore" then
			SelectedAttachment.Parent:Destroy();
			print("Destroyed core!");
		else
			SelectedAttachment:Destroy();
		end;
	end;
end;

function shared.GrabModule:Throw(_Distance, _Height, _BodyPart)
	local _GrabbedCHAR = shared.GrabModule:getCarrying();
	if _GrabbedCHAR ~= nil then
		if not _BodyPart then
			_BodyPart = "UpperTorso";
		end;
		
		shared.GrabModule:Refresh();
		--task.wait();
		
		if _GrabbedCHAR:FindFirstChild("UpperTorso") then
			_GrabbedCHAR:FindFirstChild("UpperTorso").Velocity = _LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * (_Distance or 500) + Vector3.new(0,_Height or 500,0);
		end;
		task.delay(.15, function()
			ReplicatedStorage:WaitForChild("MainEvent"):FireServer("Grabbing", false);
		end);
	end;
end;

function shared.GrabModule:MoveAlignment(_newPosition, _Time, _EasingStyle, _EasingDirection)
	if _newPosition and SelectedAttachment then
		if _Time and _EasingStyle then
			local Tween = TweenService:Create(SelectedAttachment, TweenInfo.new(_Time, _EasingStyle, _EasingDirection or Enum.EasingDirection.Out), {Position = _newPosition});
			Tween:Play();
			return Tween;
		else
			SelectedAttachment.Position = _newPosition; -- Must be smt like `CFrame.new(pos here)``
		end;
	end;
end;

function shared.GrabModule:RotateAlignment(_newRotation, _Time, _EasingStyle, _EasingDirection)
	if _newRotation and SelectedAttachment then
		if _Time and _EasingStyle then
			local Tween = TweenService:Create(SelectedAttachment, TweenInfo.new(_Time, _EasingStyle, _EasingDirection or Enum.EasingDirection.Out), {Rotation = _newRotation});
			Tween:Play();
			return Tween;
		else
			SelectedAttachment.Rotation = _newRotation;
		end;
	end;
end;

function shared.GrabModule:Align(P0, P1, _newPosition, _newRotation, BG_P, BP_P)
	shared.GrabModule:Refresh();

	local _GrabbedCHAR = shared.GrabModule:getCarrying();
	local P0 = _GrabbedCHAR:FindFirstChild(P0);

	if P1 == workspace then
		print("workspace mode enabled!")
		local Part = Instance.new("Part", workspace.Ignored);
		Part.Size = Vector3.new(0.25, 0.25, 0.25);
		Part.Transparency = 1;
		Part.Anchored = true;
Part.CFrame = CFrame.new(P0.Position);
		Part.Name = "AttachmentCore";
		
		P1 = Part;
	else
		if _LocalPlayer.Character:FindFirstChild(P1) then
			P1 = _LocalPlayer.Character:FindFirstChild(P1);
		else
			return warn("error");
		end;
	end;


	MainAttachment = Instance.new("Attachment", P1);
	SelectedAttachment = MainAttachment

	_BodyPosition, _BodyGyro = Instance.new("BodyPosition", P0), Instance.new("BodyGyro", P0);

	MainAttachment.Position = _newPosition;
MainAttachment.Orientation = _newRotation

	_BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge);
	_BodyGyro.P = BG_P or 40000;
	_BodyGyro.D = 500;
	--BG.CFrame = _LocalPlayer.Character.UpperTorso; -- Look at LocalPlayer

	_BodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge);
	_BodyPosition.P = BP_P or 40000; -- 20000
	_BodyPosition.D = 500;
	_BodyPosition.Position = MainAttachment.WorldPosition;

	task.spawn(function()
		while _BodyPosition and _BodyGyro and _GrabbedCHAR do
			pcall(function()
				if GyroLookAt then
					_BodyGyro.CFrame = CFrame.new(P0.Position, GyroLookAt.Position);
				else
					_BodyGyro.CFrame = MainAttachment.WorldCFrame;
				end;
				_BodyPosition.Position = MainAttachment.WorldPosition;
			end);
			task.wait();
		end;
	end);
end;

function shared.GrabModule:BreakLimb(Limb)
	local _GrabbedCHAR = shared.GrabModule:getCarrying();
	if _GrabbedCHAR ~= nil then
		if _GrabbedCHAR:FindFirstChild(Limb) then
			_GrabbedCHAR:FindFirstChild(Limb).Position = Vector3.new(0, -1200, 0);
		else
			warn('[⚠️] Limb has already been removed.');
		end;
	else
		warn("[⚠️] You are not dragging anyone");
	end;
end;

function shared.GrabModule:PlayAnimation(ID, SPEED, TIME, SMOOTH, LOOPING, DONTOVERRIDE)
	if not DONTOVERRIDE then
		for _, v in next, _LocalPlayer.Character:WaitForChild("Humanoid"):GetPlayingAnimationTracks() do
			if (v.Animation.AnimationId:match("rbxassetid://"..ID)) then
				v:Stop();
			end;
		end;
	end;

	local ANIM_TRACK = Instance.new('Animation');
	ANIM_TRACK.AnimationId = 'rbxassetid://'..ID
	local PLAY_ANIM = _LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(ANIM_TRACK);
	PLAY_ANIM.Priority = Enum.AnimationPriority.Action

	if LOOPING then
		PLAY_ANIM.Looped = true;
	else
		PLAY_ANIM.Looped = false;
	end;
	if SMOOTH then
		PLAY_ANIM:Play(SMOOTH);
	else
		PLAY_ANIM:Play();
	end;
	if TIME then
		PLAY_ANIM.TimePosition = TIME;
	end;
	if SPEED then
		PLAY_ANIM:AdjustSpeed(SPEED);
	else
		PLAY_ANIM:AdjustSpeed(1);
	end;
	ANIM_TRACK:Destroy();
	return PLAY_ANIM;
end;

function shared.GrabModule:StopAnimation(ID)
	for _, v in next, _LocalPlayer.Character:WaitForChild("Humanoid"):GetPlayingAnimationTracks() do
		if (v.Animation.AnimationId:match("rbxassetid://"..ID)) then
			v:Stop();
		end;
	end;
end;

-- Disconnecting all keys
if shared.Keybind_Connections then
	for _, v in next, shared.Keybind_Connections do
		v:Disconnect();
	end;
	shared.Keybind_Connections = nil;
end;
shared.Keybind_Connections = {};
function CreateKeybind(ToolName, Keybind, Callback)
	local x = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == Keybind and (_LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(ToolName)) then
			Callback();
		end;
	end);
	table.insert(shared.Keybind_Connections, x);
end;
function shared.GrabModule:CreateTool(Table)
	if Table and Table.ToolName and Table.Keybinds then
		if Table.ToolName then

			for _, Table2 in next, Table.Keybinds do
				if Table2.Keybind and Table2.Callback then
					if _LocalPlayer.Character:FindFirstChild(Table.ToolName) then _LocalPlayer.Character:FindFirstChild(Table.ToolName):Destroy(); end;
					if _LocalPlayer.Backpack:FindFirstChild(Table.ToolName) then _LocalPlayer.Backpack:FindFirstChild(Table.ToolName):Destroy(); end;

					local Tool = Instance.new("Tool", _LocalPlayer.Backpack);
					Tool.Name = Table.ToolName;
					Tool.CanBeDropped = false;
					Tool.RequiresHandle = false;
					if Table.ToolTip and Table.ToolTip ~= (nil or "") then
						Tool.ToolTip = Table.ToolTip;
					end;
					if Table.TextureId and Table.TextureId ~= (nil or "") then
						Tool.TextureId = "rbxassetid://"..Table.TextureId;
					end;
					if Table.OnActivate then
						Tool.Activated:Connect(function()
							Table.OnActivate();
						end);
					end;
					
					StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true);
					Instance.new("StringValue", Tool).Name = "Icxys_Neckgrabs";

					CreateKeybind(Table.ToolName, Table2.Keybind, Table2.Callback);
				end;
			end;
		else
			print("ERROR, ToolName not found.");
		end;
	end;
end;

function shared.GrabModule:GyroLookAt(Object)
	if Object then
		GyroLookAt = Object;
	end;
end;

function shared.GrabModule:dropPlayer()
	ReplicatedStorage:WaitForChild("MainEvent"):FireServer("Grabbing", false);
end;

function shared.GrabModule:getCarrying()
	if _LocalPlayer.Character:FindFirstChild("BodyEffects") and _LocalPlayer.Character:FindFirstChild("BodyEffects"):FindFirstChild("Grabbed") then
		return _LocalPlayer.Character:WaitForChild("BodyEffects"):FindFirstChild("Grabbed").Value;
	else
		print("BodyEffects or  BodyEffects.Grabbed, was not found.");
	end;
end;

function shared.GrabModule:getBodyGyro()
	return _BodyGyro;
end;

function shared.GrabModule:getMainAttachment()
	return MainAttachment;
end;

function shared.GrabModule:getBodyPosition()
	return _BodyPosition;
end;

function shared.GrabModule:Chat(Msg, PrivateMessagePlayer)
	if PrivateMessagePlayer then
		ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/w "..PrivateMessagePlayer.Name, 'All');
		ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(Msg, 'To '..PrivateMessagePlayer.Name);
	else
		ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(Msg, "All");
	end
end;

return shared.GrabModule;
